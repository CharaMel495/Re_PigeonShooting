  TitleTexts:
  - FaceType: 0
    Text: "\u30B2\u30FC\u30E0\u3092\u59CB\u3081\u308B\u3088\uFF01\n\u9811\u5F35\u3063\u3066\u751F\u304D\u6B8B\u308D\u3046\uFF01"
  - FaceType: 0
    Text: "\u96E3\u6613\u5EA6\u3092\u5909\u3048\u308B\u3088\n\u3069\u306E\u304A\u83D3\u5B50\u304C\u597D\u304D\uFF1F"
  - FaceType: 0
    Text: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u958B\u59CB\u3059\u308B\u3088\uFF01\n\u521D\u3081\u3066\u306E\u4EBA\u306F\u3053\u3053\u304B\u3089\uFF01"
  - FaceType: 2
    Text: "\u8A2D\u5B9A\u3060\u3088\uFF01\n\u4ECA\u306F\u6E96\u5099\u4E2D\u3060\u3088\uFF01"
  - FaceType: 0
    Text: "\u30AF\u30EC\u30B8\u30C3\u30C8\u3060\u3088\uFF01\n\u4E00\u56DE\u306F\u898B\u3066\u306D\uFF01"
  - FaceType: 0
