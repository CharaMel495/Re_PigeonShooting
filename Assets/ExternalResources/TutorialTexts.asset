--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9184abca81104c4b9aa3eb35570af9f, type: 3}
  m_Name: TutorialTexts
  m_EditorClassIdentifier: 
  MoveTutorial:
  - FaceType: 1
    Text: "\u306F\u3058\u3081\u307E\u3057\u3066\uFF01\n\u65B0\u3057\u3044\u3054\u4E3B\u4EBA\u69D8\uFF01"
  - FaceType: 0
    Text: "\u3053\u308C\u304B\u3089\u30DC\u30AF\u306E\u4F7F\u3044\u65B9\u3092\n\u8AAC\u660E\u3057\u3066\u3044\u304F\u306D\uFF01"
  - FaceType: 0
    Text: "\u307E\u305A\u306F\u79FB\u52D5\u3092\u3057\u3066\u307F\u3088\u3046\uFF01\n\u5DE6\u306E\u30B9\u30C6\u30A3\u30C3\u30AF\u3067\u79FB\u52D5\u3059\u308B\u3088\uFF01#"
  - FaceType: 1
    Text: "\u3044\u3044\u611F\u3058\uFF01\u305D\u306E\u307E\u307E\n\u30A2\u30A4\u30C6\u30E0\u3092\u63A2\u3057\u3066\u307F\u3066\uFF01#"
  - FaceType: 0
    Text: "\u4ECA\u62FE\u3063\u305F\u306E\u306F\u7D4C\u9A13\u5024\uFF01\n\u6575\u304C\u843D\u3068\u3059\u3088\uFF01"
  - FaceType: 0
    Text: "\u96C6\u3081\u308B\u3068\u30EC\u30D9\u30EB\u304C\u3042\u304C\u3063\u3066\n\u30DC\u30AF\u304C\u5F37\u304F\u306A\u308B\u3093\u3060\uFF01"
  - FaceType: 0
    Text: "\u3055\uFF01\u6B21\u306E\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u306B\n\u9032\u3082\u3046\u304B\uFF01\uFF01"
  ShotTutorial:
  - FaceType: 0
    Text: "\u3053\u3053\u3067\u306F\u653B\u6483\u65B9\u6CD5\u3092\n\u8AAC\u660E\u3059\u308B\u306D\uFF01"
  - FaceType: 0
    Text: "\u53F3\u306E\u30B9\u30C6\u30A3\u30C3\u30AF\u3092\u5012\u305B\u3070\n\u5F3E\u304C\u6483\u3066\u308B\u3093\u3060\u3051\u3069"
  - FaceType: 0
    Text: "\u30B9\u30C6\u30A3\u30C3\u30AF\u306E\u5012\u3057\u5177\u5408\u3067\n\u5909\u5316\u3059\u308B\u304B\u3089\u8A66\u3057\u3066\u307F\u3066\uFF01#"
  - FaceType: 1
    Text: "\u3044\u3044\u306D\uFF01\u62E1\u6563\u3092\u3046\u307E\u304F\n\u6271\u3048\u305F\u3089\u4E0A\u7D1A\u8005\u3060\u3088\uFF01"
  - FaceType: 0
    Text: "\u3061\u304B\u304F\u306B\u6575\u3092\u51FA\u3057\u305F\u3088\uFF01\n\u5012\u3057\u3066\u307F\u3088\u3046\uFF01#"
  - FaceType: 1
    Text: "\u30CA\u30A4\u30B9\u30B7\u30E7\u30C3\u30C8\uFF01"
  - FaceType: 0
    Text: "\u6B21\u306F\u4FBF\u5229\u306A\u6A5F\u80FD\u3092\n\u7D39\u4ECB\u3059\u308B\u3088\uFF01\uFF01"
  VacuumTutorial:
  - FaceType: 0
    Text: "\u3053\u3053\u3067\u306F\u30DC\u30AF\u306E\u6A5F\u80FD\n\u300C\u5438\u5F15\u30E2\u30FC\u30C9\u300D\u3092\u8AAC\u660E\u3059\u308B\u3088\uFF01"
  - FaceType: 0
    Text: "\u307E\u305A\u306F\u4F55\u306F\u3068\u3082\u3042\u308C\nLB\u3092\u62BC\u3057\u3066\u307F\u3088\u3046\uFF01#"
  - FaceType: 1
    Text: "\u305D\u3046\u305D\u3046\uFF01\u305D\u3093\u306A\u611F\u3058\uFF01"
  - FaceType: 0
    Text: "\u8FD1\u304F\u306B\u7D4C\u9A13\u5024\u3092\u51FA\u3057\u305F\u3088\uFF01\n\u5F15\u304D\u5BC4\u305B\u3066\u307F\u3088\u3046\uFF01#"
  - FaceType: 1
    Text: "\u30CA\u30A4\u30B9\uFF01\u4FBF\u5229\u306A\u6A5F\u80FD\u3060\u304B\u3089\n\u7D76\u5BFE\u6709\u52B9\u6D3B\u7528\u3057\u3066\u3088\u306D\uFF01"
  DashTutorial:
  - FaceType: 0
    Text: "\u3053\u3053\u3067\u306F\u300C\u30C0\u30C3\u30B7\u30E5\u300D\u3092\n\u8AAC\u660E\u3057\u3066\u3044\u304F\u3088\u30FC\uFF01"
  - FaceType: 0
    Text: "\u79FB\u52D5\u4E2D\u306BRB\u30DC\u30BF\u30F3\u3067\n\u30C0\u30C3\u30B7\u30E5\u304C\u3067\u304D\u308B\u3088\uFF01#"
  - FaceType: 1
    Text: "\u30B0\u30C3\u30C9\uFF01\u5B9F\u306F\u30C0\u30C3\u30B7\u30E5\u4E2D\u306F\n\u7121\u6575\u306B\u306A\u308B\u3088\u3063\uFF01\uFF01"
  - FaceType: 2
    Text: "\u3067\u3082\u5B9F\u6226\u3060\u3068\u56DE\u6570\u5236\u9650\u304C\n\u3042\u308B\u304B\u3089\u4F7F\u3044\u3059\u304E\u6CE8\u610F\uFF01"
  - FaceType: 0
    Text: "\u3055\u3001\u3064\u304E\u304C\u6700\u5F8C\u3060\u3088\uFF01"
  AirBasterTutorial:
  - FaceType: 0
    Text: "\u3053\u3053\u3067\u306F\u307C\u304F\u306E\u5FC5\u6BBA\u6280\n\u300C\u30A8\u30A2\u30FC\u30D0\u30B9\u30BF\u30FC\uFF01\u300D"
  - FaceType: 0
    Text: "\u3053\u308C\u3092\u8AAC\u660E\u3057\u3066\u304F\u3088\u30C3\uFF01\uFF01\n..."
  - FaceType: 0
    Text: "\u3054\u3081\u3093\u3001\u30C6\u30F3\u30B7\u30E7\u30F3\u304C\n\u5909\u306B\u306A\u3063\u3061\u3083\u3063\u305F"
  - FaceType: 0
    Text: "\u3067\u3082\u3067\u3082\u3001\u3059\u3054\u3044\u3093\u3060\u3088\uFF01"
  - FaceType: 0
    Text: "\u307E\u305A\u306F\u5468\u56F2\u306E\u307B\u3053\u308A\u3092\n\u96C6\u3081\u3066\u304F\u308C\u308B\uFF1F#"
  - FaceType: 1
    Text: "\u3055\u3063\u3059\u304C\uFF01"
  - FaceType: 0
    Text: "\u3067\u3001\u3053\u3053\u3067\u8A66\u3057\u3066\u6B32\u3057\u3044\u3093\u3060\u3051\u3069\n\u5C04\u6483\u3057\u3066\u307F\u3066\uFF01#"
  - FaceType: 2
    Text: "\u307B\u3053\u308A\u306E\u5F71\u97FF\u3067\u5F3E\u304C\n\u30B8\u30E3\u30E0\u308B\u3088\u3046\u306B\u306A\u3063\u305F\u306D..."
  - FaceType: 2
    Text: "\u30B8\u30E3\u30E0\u308B\u78BA\u7387\u306F\u307B\u3053\u308A\u306E\n\u6E9C\u307E\u308A\u5177\u5408\u3067\u5909\u5316\u3059\u308B\u3088"
  - FaceType: 0
    Text: "\u305D\u306E\u30EA\u30B9\u30AF\u3092\u8D85\u3048\u305F\u5148\u306B\u306F\n\u3059\u3054\u3044\u306E\u304C\u3042\u308B\u3088\uFF01"
  - FaceType: 1
    Text: "R\u30B9\u30C6\u30A3\u30C3\u30AF\u3092\u62BC\u3057\u3053\u3093\u3067\n\u300C\u30A8\u30A2\u30FC\u30D0\u30B9\u30BF\u30A1\u30FC\uFF01\u300D#"
  - FaceType: 1
    Text: "\u4F55\u5EA6\u3084\u3063\u3066\u3082\n\u3059\u304B\u3063\u3068\u3059\u308B\u306D\uFF01"
  - FaceType: 0
    Text: "\u3053\u308C\u3092\u4F7F\u3046\u3068\u307B\u3053\u308A\u304C\n\u7A7A\u3063\u307D\u306B\u306A\u308B\u3088\uFF01"
  - FaceType: 0
    Text: "\u3053\u308C\u3082\u6E9C\u307E\u308A\u5177\u5408\u3067\u6027\u80FD\u304C\n\u5909\u5316\u3059\u308B\u304B\u3089\u8A66\u3057\u3066\u307F\u3066\u306D\uFF01"
